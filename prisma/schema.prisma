generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  phone         String?      @unique
  phoneVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  auditLogs     AuditLog[]
  sessions      Session[]
  tenants       TenantUser[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id           String          @id @default(cuid())
  name         String
  logoUrl      String?
  industry     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AuditLog[]
  config       BusinessConfig?
  customers    Customer[]
  imports      Import[]
  ledgerEvents LedgerEvent[]
  subscription Subscription?
  users        TenantUser[]
}

model Subscription {
  id         String  @id @default(cuid())
  tenantId   String  @unique
  plan       String  @default("FREE")
  status     String  @default("ACTIVE")
  razorpayId String?
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessConfig {
  id               String @id @default(cuid())
  tenantId         String @unique
  defaultCycle     Int    @default(30)
  defaultGrace     Int    @default(7)
  riskWeightDelay  Float  @default(0.6)
  riskWeightLimit  Float  @default(0.4)
  reminderTone     String @default("FRIENDLY")
  autoApproveLimit Float  @default(0)
  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantUser {
  id       String   @id @default(cuid())
  tenantId String
  userId   String
  role     UserRole @default(STAFF)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model Customer {
  id            String                 @id @default(cuid())
  tenantId      String
  name          String
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditProfile CustomerCreditProfile?
  ledgerEvents  LedgerEvent[]
  receivables   ReceivableItem[]
  reminderJobs  ReminderJob[]
  riskSnapshots RiskScoreSnapshot[]
}

model CustomerCreditProfile {
  id             String   @id @default(cuid())
  customerId     String   @unique
  creditLimit    Float    @default(0)
  paymentCycle   Int      @default(30)
  gracePeriod    Int      @default(0)
  lateFeePercent Float    @default(0)
  reminderFreq   Int      @default(7)
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ReceivableItem {
  id           String              @id @default(cuid())
  customerId   String
  amount       Float
  description  String?
  dueDate      DateTime
  isPaid       Boolean             @default(false)
  paidAmount   Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  payments     PaymentAllocation[]
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reminderJobs ReminderJob[]
}

model PaymentAllocation {
  id               String         @id @default(cuid())
  receivableItemId String
  amount           Float
  paymentDate      DateTime       @default(now())
  receivableItem   ReceivableItem @relation(fields: [receivableItemId], references: [id], onDelete: Cascade)
}

model LedgerEvent {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  amount     Float
  tag        EntryTag @default(SALE)
  note       String?
  eventDate  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RiskScoreSnapshot {
  id           String    @id @default(cuid())
  customerId   String
  score        Int
  level        RiskLevel @default(GREEN)
  reason       String?
  snapshotDate DateTime  @default(now())
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ReminderJob {
  id               String          @id @default(cuid())
  customerId       String
  receivableItemId String?
  status           String          @default("PENDING")
  scheduledFor     DateTime
  sentAt           DateTime?
  message          String?
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receivableItem   ReceivableItem? @relation(fields: [receivableItemId], references: [id])
}

model Import {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  status    String   @default("PROCESSING")
  rowCount  Int      @default(0)
  errorLog  String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

enum UserRole {
  OWNER
  STAFF
}

enum EntryTag {
  SALE
  RETURN
  ADJUSTMENT
  PAYMENT
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
}
